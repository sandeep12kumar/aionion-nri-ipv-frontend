# Copy to .env.production and fill in, then run: npm run package:amplify
# The API Gateway HTTP API address (Invoke URL), without /api at the end.
VITE_API_URL=https://abc123.execute-api.ap-south-1.amazonaws.com
# The API Gateway WebSocket address, including the stage name.
VITE_WS_URL=wss://xyz789.execute-api.ap-south-1.amazonaws.com/production
